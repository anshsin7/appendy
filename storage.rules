rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Each user can only touch their own folder: users/{uid}/{fileId}
    match /users/{userId}/{fileId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 50 * 1024 * 1024                       // 50 MB per file
        && request.resource.contentType.matches('application/pdf|image/png|image/jpeg');
    }
    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
